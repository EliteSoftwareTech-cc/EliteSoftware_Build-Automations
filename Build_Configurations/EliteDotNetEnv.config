                       "g++ -m32 -O3 -o src\\EliteSoftware-DotNetEnv\\x86\\EliteDotNetEnv.exe src\\EliteSoftware-DotNetEnv\\main.cpp src\\EliteSoftware-DotNetEnv\\app.res -lole32 -luuid -lshell32",
                       "cmd /c if exist \"BuildOutputx86\\EliteDotNetEnv.exe\" del /f /q \"BuildOutputx86\\EliteDotNetEnv.exe\"",
