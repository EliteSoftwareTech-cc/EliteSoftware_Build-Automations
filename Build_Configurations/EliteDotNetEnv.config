                       "cmd /c if exist \"BuildOutputx64\\EliteDotNetEnv.exe\" del /f /q \"BuildOutputx64\\EliteDotNetEnv.exe\"",
                       "cmd /c mklink \"BuildOutputx64\\EliteDotNetEnv.exe\" \"..\\src\\EliteSoftware-DotNetEnv\\x64\\EliteDotNetEnv.exe\"",
