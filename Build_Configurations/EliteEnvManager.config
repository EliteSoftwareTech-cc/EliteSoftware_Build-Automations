                       "cmd /c if exist \"BuildOutputx64\\EliteEnvManager.exe\" del /f /q \"BuildOutputx64\\EliteEnvManager.exe\"",
                       "cmd /c mklink \"BuildOutputx64\\EliteEnvManager.exe\" \"..\\src\\EliteSoftware-EnvManager\\x64\\EliteEnvManager.exe\"",
