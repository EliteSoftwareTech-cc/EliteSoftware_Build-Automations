                       "g++ -m32 -O3 -o src\\EliteSoftware-EnvManager\\x86\\EliteEnvManager.exe src\\EliteSoftware-EnvManager\\main.cpp src\\EliteSoftware-EnvManager\\app.res -lole32 -luuid -lshell32",
                       "cmd /c if exist \"BuildOutputx86\\EliteEnvManager.exe\" del /f /q \"BuildOutputx86\\EliteEnvManager.exe\"",
