
#include <winres.h>
#include "..\version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RAH_VERSION_MAJOR,RAH_VERSION_MINOR,RAH_VERSION_PATCH,RAH_VERSION_BUILD
 PRODUCTVERSION RAH_VERSION_MAJOR,RAH_VERSION_MINOR,RAH_VERSION_PATCH,RAH_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EliteSoftwareTech Co."
            VALUE "FileDescription", "Resource Alchemy Hacker Shell Extension"
            VALUE "FileVersion", RAH_VERSION_ANSI
            VALUE "InternalName", "ResourceAlchemyHacker_ShellExt.dll"
            VALUE "LegalCopyright", "Copyright (C) 2026 EliteSoftwareTech Co."
            VALUE "OriginalFilename", "ResourceAlchemyHacker_ShellExt.dll"
            VALUE "ProductName", "Resource Alchemy Hacker"
            VALUE "ProductVersion", RAH_VERSION_ANSI
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

