#include <windows.h>
#include "../include/Resource.h"

// Icon Resource
IDI_APPICON ICON "FileSplitter.ico"

// Manifest Resource (Common Controls v6 Visual Styles)
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "FileSplitter.manifest"

// Version Information Resource
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EliteSoftwareTech Co."
            VALUE "FileDescription", "File Splitter For AI Upload"
            VALUE "FileVersion", "1.2.0.0"
            VALUE "InternalName", "FileSplitter"
            VALUE "OriginalFilename", "FileSplitter.exe"
            VALUE "ProductName", "File Splitter For AI Upload"
            VALUE "ProductVersion", "1.2.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 EliteSoftwareTech Co."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
